# Set APP_DOMAIN and API_DOMAIN to real DNS names before starting Caddy.
{$API_DOMAIN} {
    request_body {
        max_size 9MB
    }
    reverse_proxy 127.0.0.1:4000
    header Strict-Transport-Security "max-age=31536000"
}
{$APP_DOMAIN} {
    root * /srv/fotosnaps/frontend/dist
    @private path /.git* /.env* /*.sql /*.bak /*.map
    respond @private 404
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://{$API_DOMAIN} https://*.supabase.co https://maps.googleapis.com https://maps.gstatic.com https://ipwho.is https://ipapi.co; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
    try_files {path} /index.html
    file_server
}
